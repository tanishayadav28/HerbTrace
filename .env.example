# Copy this file to ".env" and edit the values. Never commit the real .env file.

# ---- Django
# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set to False when running DEBUG=False over plain http on your own PC
DJANGO_HTTPS=False

# Base URL that is encoded in QR codes. For scanning with a phone on the same
# Wi-Fi use your PC's LAN IP, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- Database (MySQL)
DB_ENGINE=mysql
DB_NAME=herb_traceability
DB_USER=herb_user
DB_PASSWORD=put-your-mysql-password-here
DB_HOST=127.0.0.1
DB_PORT=3306
